# Tavily API key for web search (Phase 4)
TAVILY_API_KEY=your_key_here

# Local Ollama LLM configuration
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# When false, disables Qwen3 reasoning/thinking tokens for faster responses
ENABLE_THINKING=false

# Vector Database & Embeddings (Phase 3)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ipl_matches
EMBED_MODEL=nomic-embed-text
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LangGraph workshop (workshop/langgraph_workshop_demo.py)
# VECTOR_BACKEND=qdrant   # default in this repo (use ingest + Docker)
# VECTOR_BACKEND=chroma   # classroom setups with local ChromaDB
# CHROMA_PATH=./chroma_db
# CHROMA_COLLECTION=cricket_matches

# TypeSafe System One (Jev) API key for query routing
TYPESAFE_API_KEY=your_key_here
